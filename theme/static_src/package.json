{
  "name": "sami-theme",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "npm run dev",
    "build": "npm run build:clean && npm run build:fontawesome && npm run build:tailwind",
    "build:clean": "rimraf ../static/css/dist",
    "build:fontawesome": "copyfiles -u 3 node_modules/@fortawesome/fontawesome-free/js/all.min.js ../static/vendor/fontawesome",
    "build:tailwind": "cross-env NODE_ENV=production postcss ./src/styles.css -o ../static/css/dist/styles.css --minify",
    "dev": "cross-env NODE_ENV=development postcss ./src/styles.css -o ../static/css/dist/styles.css --watch"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "7.3.1",
    "@tailwindcss/postcss": "^4.3.0",
    "copyfiles": "^2.4.1",
    "cross-env": "^10.1.0",
    "postcss": "^8.5.15",
    "postcss-cli": "^11.0.1",
    "postcss-nested": "^7.0.2",
    "postcss-simple-vars": "^7.0.1",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.0"
  }
}
