# Django
DJANGO_SECRET_KEY=reemplazar-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=True

# MySQL
MYSQL_DATABASE=sami_db
MYSQL_USER=jaifer08
MYSQL_PASSWORD=reemplazar-por-una-contrasena-segura
MYSQL_HOST=mysql_server
MYSQL_PORT=3306
MYSQL_CONN_MAX_AGE=60

# Archivos multimedia. DJANGO_MEDIA_ROOT debe apuntar a un volumen persistente.
DJANGO_MEDIA_ROOT=/app/media
# Alternativa S3-compatible (si AWS_STORAGE_BUCKET_NAME está vacío se usa disco local)
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=

# Contacto mostrado en la página de mantenimiento
CONTACT_EMAIL=contacto@samitravelstours.com

# Correo SMTP para invitaciones de usuarios
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=no-reply@samitravelstours.com
EMAIL_HOST_PASSWORD=reemplazar-por-la-contrasena-smtp
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=SAMI Travels & Tours <no-reply@samitravelstours.com>
INVITATION_TIMEOUT=86400

# Seguridad de producción (activar detrás de HTTPS después de probar el dominio)
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_PRELOAD=False

# Máximo de envíos del formulario público por IP y ventana en segundos
PUBLIC_FORM_RATE_LIMIT=5
PUBLIC_FORM_RATE_WINDOW=3600
ADMIN_LOGIN_RATE_LIMIT=5
ADMIN_LOGIN_RATE_WINDOW=900
